{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "x32 — start w myfsqrt",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/program",
            "args": ["${input:sqrtArg}"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "make",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "text": "set architecture i386",
                    "ignoreFailures": true
                },
                {
                    "text": "break myfsqrt"
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "sqrtArg",
            "type": "promptString",
            "description": "Argument (np. 9)",
            "default": "9"
        }
    ]
}
