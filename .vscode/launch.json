            "setupCommands": [
                {
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "text": "set architecture i386",
                    "ignoreFailures": true
                },
                {
                    "text": "set disassemble-next-line on",
                    "ignoreFailures": true
                },
                {
                    "text": "break myfsqrt",
                    "description": "Auto-stop na poczatku myfsqrt"
                }
            ]
        },
