{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "x32 — myfsqrt (rejestry BINARNIE)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/x32_version/program",
            "args": ["${input:sqrtArg}"],
            "cwd": "${workspaceFolder}/x32_version",
            "preLaunchTask": "make x32",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "text": "set architecture i386",
                    "ignoreFailures": true
                },
                {
                    "text": "set output-radix 16",
                    "description": "hex domyslnie (IEEE float); binarnie: b32 $eax lub print/t"
                },
                {
                    "text": "source ${workspaceFolder}/x32_version/gdb-myfsqrt.gdb",
                    "ignoreFailures": true
                },
                {
                    "text": "set disassemble-next-line on",
                    "ignoreFailures": true
                },
                {
                    "text": "break myfsqrt"
                }
            ]
        },
        {
            "name": "x32 — start w myfsqrt (bez breakpointow)",
